.chat { display: flex; flex-direction: column; height: 100vh; }
.msgs { flex: 1; padding: 24rpx 28rpx; box-sizing: border-box; }

.row { display: flex; margin-bottom: 20rpx; }
.row.right { justify-content: flex-end; }
.row.left { justify-content: flex-start; }
.bub { max-width: 78%; padding: 18rpx 24rpx; border-radius: 24rpx; font-size: 29rpx; line-height: 1.5; word-break: break-word; }
.bub.user { background: var(--indigo); color: #fff; border-bottom-right-radius: 8rpx; }
.bub.ai { background: var(--surface); color: var(--ink); border: 2rpx solid var(--line); border-bottom-left-radius: 8rpx; white-space: pre-wrap; }

.think { max-width: 88%; border-left: 6rpx solid var(--indigo); background: #f3f0fd; border-radius: 8rpx 18rpx 18rpx 8rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.think-lbl { font-size: 22rpx; font-weight: 700; color: #4b37a8; }
.think-tx { font-size: 26rpx; color: var(--muted); font-style: italic; margin-top: 8rpx; line-height: 1.55; white-space: pre-wrap; }

.tool { background: #14131a; color: #d6d3e0; font-size: 24rpx; padding: 16rpx 20rpx; border-radius: 14rpx; margin-bottom: 20rpx; white-space: pre-wrap; word-break: break-all; }
.filepill { display: inline-block; background: var(--surface); border: 2rpx solid var(--line); color: var(--muted); font-size: 24rpx; padding: 10rpx 18rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.img { max-width: 78%; border-radius: 18rpx; border: 2rpx solid var(--line); }
.sys { text-align: center; color: var(--faint); font-size: 24rpx; margin: 16rpx 0; }

.running { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 28rpx; font-size: 24rpx; color: var(--muted); }
.running .dot { color: var(--indigo); }
.running .stop { margin-left: auto; color: #d2576b; font-weight: 600; }

.appr { margin: 0 28rpx 16rpx; background: #fbf7ff; border: 2rpx solid #e7e1fb; border-radius: 20rpx; padding: 20rpx; }
.appr-h { font-weight: 700; color: #4b37a8; font-size: 27rpx; }
.appr-cmd { margin: 14rpx 0; padding: 16rpx; background: #14131a; color: #d6d3e0; border-radius: 12rpx; font-size: 24rpx; max-height: 280rpx; overflow: auto; white-space: pre-wrap; word-break: break-all; }
.appr-btns { display: flex; gap: 16rpx; }
.appr-no { flex: 1; background: var(--surface); border: 2rpx solid var(--line); color: var(--ink); border-radius: 999rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-weight: 600; }
.appr-yes { flex: 1; background: var(--indigo); color: #fff; border-radius: 999rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-weight: 600; }

.composer { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 2rpx solid var(--line); }
.cin { flex: 1; background: var(--bg); border: 2rpx solid var(--line); border-radius: 999rpx; height: 80rpx; padding: 0 28rpx; font-size: 28rpx; }
.cph { color: var(--faint); }
.cbtn { background: var(--indigo); color: #fff; font-weight: 600; border-radius: 999rpx; height: 80rpx; line-height: 80rpx; padding: 0 36rpx; }
